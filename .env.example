# FleetLeak Environment Configuration
# System & Infrastructure
ENVIRONMENT=production
LOG_LEVEL=INFO
APP_PORT=8000
WEB_PORT=3000

# PostgreSQL / TimescaleDB
POSTGRES_USER=fleet_admin
POSTGRES_PASSWORD=fleet_secure_password_2026
POSTGRES_DB=fleetleak
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://fleet_admin:fleet_secure_password_2026@postgres:5432/fleetleak

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Redpanda (Kafka-compatible) Broker
KAFKA_BROKERS=redpanda:9092
KAFKA_CLIENT_ID=fleetleak-platform
REDPANDA_MODE=dev

# Topics
TOPIC_TELEMETRY_RAW=telemetry.raw
TOPIC_TELEMETRY_CANONICAL=telemetry.canonical
TOPIC_TELEMETRY_DLQ=telemetry.dlq
TOPIC_LEAK_DETECTED=leak.detected
TOPIC_AGENT_AUDIT=agent.audit

# Security & Auth (JWT & OIDC)
JWT_SECRET=fle3tle4k_sup3r_s3cr3t_jwt_k3y_987654321
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Hybrid AI Copilot Settings
# Provide OPENAI_API_KEY or GEMINI_API_KEY to activate Live LLM Copilot mode.
# If no key is configured, the system automatically falls back to the labeled Rule-Based Mock Copilot.
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
COPILOT_MODEL=gemini-3.8-flash
COPILOT_FALLBACK_MODE=rule_based_mock

# Simulator Parameters
SIMULATOR_NUM_VEHICLES=100000
SIMULATOR_NUM_TENANTS=20
SIMULATOR_BURST_MULTIPLIER=3
SIMULATOR_TARGET_RATE_EPS=2500
